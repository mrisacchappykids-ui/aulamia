# PostgreSQL is required on Vercel. Leave this empty for local SQLite.
STORAGE_POSTGRES_URL=
# Optional local SQLite override and data directory.
AULAMIA_USE_SQLITE=
AULAMIA_DATA_DIR=
# Optional. Import legacy accounts from a private file on the same machine.
AULAMIA_LEGACY_USERS_FILE=
# Comma-separated additional origins, such as a custom frontend domain.
CORS_ORIGINS=
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
